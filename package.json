{
  "name": "code-navigation",
  "displayName": "Code Navigation — Tree from Comment Tags",
  "description": "Hierarchical code navigation based on comment tags",
  "version": "0.1.9",
  "publisher": "fiimm",
  "engines": {
    "vscode": "^1.85.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fiimm/code-navigation.git"
  },
  "categories": ["Other", "Programming Languages", "Visualization"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeNavContainer",
          "title": "Code Navigation",
          "icon": "$(list-tree)"
        }
      ]
    },
    "views": {
      "codeNavContainer": [
        {
          "id": "codeNavView",
          "name": "Navigation Map",
          "type": "tree"
        }
      ]
    },
    "configuration": {
      "title": "Code Navigation",
      "properties": {
        "codeNav.prefix": {
          "type": "string",
          "default": "NAV_",
          "description": "Prefix for navigation tags (e.g., NAV_)(without comment symbols)"
        },
        "codeNav.maxDepth": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum depth of the navigation tree"
        },
        "codeNav.enabledMarker": {
          "type": "string",
          "default": "{PREFIX}ENABLED",
          "description": "Marker in first lines to enable Navigation file scanning. {PREFIX} is replaced by prefix"
        },
        "codeNav.scanFirstLines": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 20,
          "description": "Number of first lines to check for Navigation ENABLED marker"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "20.x",
    "typescript": "^5.3.0"
  },
  "icon": "icon.png",
  "keywords": [
    "navigation",
    "code navigation",
    "comment tags",
    "tree",
    "embedded",
    "c",
    "cpp",
    "bookmarks",
    "code map"
  ]
}
